# Database Configuration
DB_PASSWORD=change_this_password_in_production
DATABASE_URL=postgresql://emulator_admin:change_this_password_in_production@postgres:5432/emulator_platform

# Redis Configuration
REDIS_URL=redis://redis:6379

# Application Configuration
NODE_ENV=production
PORT=3001

# Emulator Configuration
MAX_CONCURRENT_EMULATORS=25
EMULATOR_RAM_GB=3
EMULATOR_CPU_CORES=2
SESSION_TIMEOUT_MINUTES=30

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
CORS_ORIGIN=*

# Monitoring
GRAFANA_PASSWORD=admin

# File Upload
MAX_APK_SIZE_MB=100
UPLOAD_DIR=/app/apks

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# Docker Configuration
DOCKER_SOCKET=/var/run/docker.sock
EMULATOR_NETWORK=emulator-network
EMULATOR_IMAGE=budtmo/docker-android:emulator_11.0

# Port Range for Emulators
VNC_PORT_START=6080
ADB_PORT_START=5554

# Optional: Email notifications (for alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL=admin@yourdomain.com

# Optional: Payment Integration
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://...@sentry.io/...
